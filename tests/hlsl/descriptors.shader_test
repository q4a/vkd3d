size (2d, 1, 1)

2.0

[uav 3]
format r32-float
size (2d, 1, 1)

3.0

[pixel shader]
RWTexture2D<float> u : register(u2);

float4 main() : SV_Target
{
    return u[uint2(0, 0)];
}

[descriptors]

